# Copy to .env (never commit). All optional; defaults are placeholders.
SITE_URL=https://organizemymac.example
# Where videos/screenshots are served from (R2 public domain). Empty = same origin /media
PUBLIC_MEDIA_BASE=
# Flip to "true" only after the app is signed + notarized and the DMG is published
PUBLIC_DOWNLOAD_LIVE=false
PUBLIC_DMG_URL=
PUBLIC_VERSION=
PUBLIC_PRICE=
PUBLIC_MIN_MACOS=
PUBLIC_ARCH=
PUBLIC_SHA256=
PUBLIC_RELEASE_NOTES_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_CONTACT_EMAIL=
# Optional cookie-less analytics (self-hosted Plausible/Umami). Both or neither.
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=
